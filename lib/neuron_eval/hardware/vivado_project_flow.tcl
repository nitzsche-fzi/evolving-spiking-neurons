# Tested with Vivado 2024.1 on Windows and Ubuntu.
namespace eval ::vivado {
    variable board_name "xilinx.com:kv260_som:part0:1.4"
    variable top_module "design_1_wrapper"
    variable synth_run_name "synth_1"
    variable impl_run_name  "impl_1"
    variable script_dir   [file dirname [info script]]
    variable outputs_dir  "not_initialized"
    variable project_dir  "not_initialized"
    variable project_path "not_initialized"
    # use_xil_ips may lead to more accurate power and timing estimations but also increases synthesis time.
    variable use_xil_ips  0

    # Create project structure
    proc create_vivado_project {name part_number out_dir_param} {
        variable board_name
        variable script_dir
        variable outputs_dir
        variable project_dir
        variable project_path
        variable use_xil_ips

        set outputs_dir  $out_dir_param
        set project_dir  [file join $outputs_dir vivado]
        set project_path [file join $project_dir ${name}.xpr]
        create_project -force $name $project_dir \
                       -part  $part_number
        #               -in_memory
        set_property BOARD_PART $board_name [current_project]

        # Add IP generated by Vitis HLS
        set ip_dir  [file join $outputs_dir ip]
        set ip_path [file join $ip_dir ip.zip]
        set_property ip_repo_paths $ip_dir [current_project]
        update_ip_catalog -rebuild
        update_ip_catalog -add_ip $ip_path -repo_path $ip_dir
        # Create block design with this IP
        create_bd_design "design_1"
        create_bd_cell -type ip -vlnv xilinx.com:hls:forward:1.0 neuron_0
        # Auto-connect clocks/resets
        if {$use_xil_ips} {  ## With Clocking Wizard and Processor System Reset IPs
            apply_bd_automation -rule xilinx.com:bd_rule:clkrst -config {Clk {New Clocking Wizard} Freq {100}}            [get_bd_pins neuron_0/ap_clk]
            apply_bd_automation -rule xilinx.com:bd_rule:board  -config {Clk {New External Port} Manual_Source {Auto}}    [get_bd_pins clk_wiz/clk_in1]
            apply_bd_automation -rule xilinx.com:bd_rule:board  -config {Manual_Source {New External Port (ACTIVE_HIGH)}} [get_bd_pins clk_wiz/reset]
            apply_bd_automation -rule xilinx.com:bd_rule:board  -config {Manual_Source {Auto}}                            [get_bd_pins rst_clk_wiz_100M/ext_reset_in]
        } else {            ## Without any additional IPs
            create_bd_port -dir I -type clk -freq_hz 100000000 clk_100MHz
            create_bd_port -dir I -type rst reset_rtl
            set_property CONFIG.POLARITY ACTIVE_HIGH [get_bd_ports reset_rtl]
            connect_bd_net -net clk_100MHz_1 [get_bd_ports clk_100MHz] [get_bd_pins neuron_0/ap_clk]
            connect_bd_net -net reset_rtl_1  [get_bd_ports reset_rtl]  [get_bd_pins neuron_0/ap_rst]
        }
        # Make all remaining data pins (state ports) external ports
        set data_pins [get_bd_pins -of_objects [get_bd_cells neuron_0] -filter {NAME !~ "ap_*" && NAME != "x"}]
        make_bd_pins_external      $data_pins
        make_bd_pins_external      [get_bd_pins neuron_0/x]
        make_bd_pins_external      [get_bd_pins neuron_0/ap_return]
        make_bd_intf_pins_external [get_bd_intf_pins neuron_0/ap_ctrl]
        # Generate wrapper and set as top
        make_wrapper -files [get_files $project_dir/${name}.srcs/sources_1/bd/design_1/design_1.bd] -top
        add_files -norecurse $project_dir/${name}.gen/sources_1/bd/design_1/hdl/design_1_wrapper.v
        set_property top design_1_wrapper [current_fileset]

        # Add simulation files
        add_files -fileset sim_1 -norecurse [list \
            $project_dir/tb_neuron.sv       \
            $project_dir/assertions.vh      \
            $project_dir/neuron_config.vh   \
        ]
        set_property top tb_neuron [get_filesets sim_1]

        # Add constraint files
        add_files -fileset constrs_1 -norecurse $project_dir/constraints.xdc
    }

    proc configure_synthesis {more_options} {
        variable synth_run_name

        if {[string trim $more_options] != ""} {
            puts "Setting Vivado synthesis options: $more_options"
            set_property -name {STEPS.SYNTH_DESIGN.ARGS.MORE OPTIONS} -value $more_options -objects [get_runs $synth_run_name]
        }
    }

    proc write_checkpoint {run_name} {
        variable project_dir

        open_run $run_name
        set chkpt_path [file join $project_dir "post_$run_name"]
        write_checkpoint -force $chkpt_path
    }
}

